# secrets
.env
*.log
*.out
*.gdt
*.py

# sandbox folder
sandbox/

# extracted FASTAs and tree, at any depth
**/igr_fastas/
**/igr_trees/
**/cds_tree/
**/gff3/
**/fasta/
**/qc_purge/

# Entrez lineage intermediates, at any depth
*_raw_lineage.tsv

# group-level summary atlas only (e.g. plants_plt/plants_plt_summary_atlas.tsv);
# subgroup atlases like plants_plt/solanaceae/solanaceae_summary_atlas.tsv are kept
/*/*_summary_atlas.tsv

# alignment outputs, at any depth
**/alignments/*/*.fasta
**/alignments/*/logs/
**/alignments/*/_stale/
**/alignments/*/tmp/
**/alignments/*_aln.tsv
